[Unit]
Description=Start user units stored in the encrypted home directory
# Installed to /etc/systemd/user by scripts/install-home-units.sh, so every
# user manager sees it while the home directory is still locked.
#
# With dirlock, the user manager starts before the home directory is unlocked.
# It can't read ~/.config/systemd/user then, so units enabled there (like
# webterm.socket) never start. This waits for the unlock (encrypted names
# hide ~/.config until then), reloads the user manager so it sees those units,
# and starts just those units; see /etc/steamos-config/home-units-start.

[Service]
ExecStart=/etc/steamos-config/home-units-start
# Show as "active (exited)" once done, and don't run again on a later start of
# default.target.
RemainAfterExit=yes

[Install]
WantedBy=default.target
