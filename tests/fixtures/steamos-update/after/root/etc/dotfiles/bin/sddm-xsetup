#!/bin/bash
# Lay out the displays for SDDM's X11 login screen, which a dirlock-encrypted home always shows at boot (autologin can't
# unlock it). X11's own layout puts the laptop panel and an external display side by side, which left the panel black
# and the projector without a signal. Instead:
#  - no external display: the panel
#  - external display, lid closed: turn the panel off, so the login screen fills the external display at its own mode
#  - external display, lid open: mirror the panel onto it, stretched to fit (the panel only offers its native 16:10
#    mode, so a 16:9 display squashes it slightly)
# The layout is applied again whenever the lid or a display connection changes while the login screen is up, e.g.
# unplugging the projector and opening the lid. Installed into /etc/dotfiles/bin by the orei_switch feature of
# ~/dotfiles/install.sh and run by SDDM as the sddm user (/etc/sddm.conf.d/orei-switch.conf).
#
# SDDM waits for this script before it shows the login screen. After 30 s it kills the script, and since a script that
# fails or is killed ends SDDM's X server too, that leaves a black screen with no way to log in; so it must always exit
# 0, and soon. Laying out the displays once took over 10 s with an eGPU attached, so the layout runs in a detached
# process: the script returns once that has laid the displays out, or after APPLY_WAIT seconds regardless, and then
# logs which step was still running. xrandr --query makes X probe every output of every GPU again, so the layout reads
# X's current state instead: X probed at startup and probes again on hotplug.
APPLY_WAIT=10

log() { logger -t orei-switch "login screen: $*"; }

# Print output $1's current mode (WxH) from xrandr output $2.
current_mode() {
  awk -v o="$1" '$1 == o { for (i = 2; i <= NF; i++) if ($i ~ /^[0-9]+x[0-9]+\+/) { sub(/\+.*/, "", $i); print $i; exit } }' \
    <<<"$2"
}

# Return 0 if the ACPI lid switch reports closed; a missing switch counts as open.
lid_closed() {
  grep -qs closed /proc/acpi/button/lid/*/state
}

# Print what the layout depends on: the lid and each DRM connector's status. Cheap to read, unlike an xrandr probe.
layout_inputs() {
  cat /proc/acpi/button/lid/*/state /sys/class/drm/card*-*/status 2>/dev/null | tr -s ' \n' ' '
}

apply_layout() {
  local outputs internal external mode mode_args size
  outputs="$(xrandr --current)" || return 1
  internal="$(awk '/^eDP[^ ]* connected/ { print $1; exit }' <<<"$outputs")"
  external="$(awk '/^(DisplayPort|DP|HDMI)[^ ]* connected/ { print $1; exit }' <<<"$outputs")"
  log "$(grep ' connected' <<<"$outputs" | tr '\n' ';')"
  [[ -n "$internal" ]] || return 0
  if [[ -z "$external" ]]; then
    xrandr --output "$internal" --auto --primary && log "$internal only"
    return 0
  fi
  # Keep the mode X picked for the external display (1920x1080 on the projector), or let xrandr pick its preferred one.
  mode="$(current_mode "$external" "$outputs")"
  mode_args=(--auto)
  [[ -n "$mode" ]] && mode_args=(--mode "$mode")

  if lid_closed; then
    if xrandr --output "$external" "${mode_args[@]}" --primary --pos 0x0 --output "$internal" --off; then
      log "lid closed: $internal off, $external at $(current_mode "$external" "$(xrandr --current)")"
      return 0
    fi
    log "lid closed, but could not turn $internal off; mirroring instead"
  fi

  xrandr --output "$internal" --auto --primary
  size="$(current_mode "$internal" "$(xrandr --current)")"
  if xrandr --output "$external" "${mode_args[@]}" --scale-from "$size" --same-as "$internal"; then
    log "mirroring $internal ($size) onto $external, stretched"
  else
    log "could not mirror $internal onto $external"
  fi
}

# Re-apply the layout when its inputs change, until the X server goes away (on login).
watch_layout() {
  local last now
  last="$(layout_inputs)"
  while xrandr --current >/dev/null 2>&1; do
    sleep 1
    now="$(layout_inputs)"
    [[ "$now" == "$last" ]] && continue
    last="$now"
    sleep 1  # let a hotplug settle (EDID, X's own probe)
    apply_layout
  done
}

# Lay the displays out, tell the waiting script by removing $1 (which names the step running until then), then keep
# them laid out until the X server goes away.
start() {
  # SteamOS's own DisplayCommand, which this replaces.
  echo holo-rotate-x11-screen >"$1"
  /usr/lib/holo/holo-rotate-x11-screen || true
  echo 'xrandr layout' >"$1"
  apply_layout
  rm -f "$1"
  watch_layout
}

if [[ "${1:-}" == --start ]]; then
  start "$2"
  exit 0
fi
pending="$(mktemp)"
# Detached from SDDM's session and output, so SDDM doesn't wait for it.
setsid "$0" --start "$pending" </dev/null >/dev/null 2>&1 &
for (( i = 0; i < APPLY_WAIT * 4; i++ )); do
  [[ -e "$pending" ]] || exit 0
  sleep 0.25
done
log "displays not laid out after ${APPLY_WAIT}s, still in $(cat "$pending" 2>/dev/null); showing the login screen"
rm -f "$pending"
exit 0
