#!/bin/bash
# Suspend, or idle with the displays off while an eGPU sits on the Framework 16 expansion bay or the laptop is on
# external power. Installed into /etc/dotfiles/bin by the light_sleep feature of ~/dotfiles/install.sh, and run by
# systemd-suspend.service in place of systemd-sleep (see its drop-in light-sleep.conf). See docs/light-sleep.md.
#
# An eGPU on the bay's M.2 slot loses its PCIe link whenever the SoC reaches hardware sleep (S0i3) and never gets it
# back: it has its own power supply, so it never sees the reset a new link needs. Nothing in Linux keeps s2idle out of
# S0i3, so while a live one is attached, sleep is a light sleep instead. On external power it is one too, so the
# network stays up for Tailscale SSH and webterm. A light sleep freezes only the graphical sessions (their scopes, and
# their users' app, session and background slices) and waits for a key or the power button, so SSH logins and
# webterm (in its own webterm.slice) keep running. The compositor has already turned the displays off, on logind's
# PrepareForSleep; in Desktop Mode, KWin lights the laptop panel again when orei-switch's PD cut removes the
# projector's output, so it is turned off again here, after that.
# logind, Steam and the units on sleep.target still see an ordinary suspend.
#
# Usage: light-sleep suspend|hibernate|hybrid-sleep|suspend-then-hibernate  (as systemd-sleep, from the drop-in)
#        light-sleep wake  (as root, e.g. sudo over SSH: end a light sleep, as a key press would)
ROOT_PORT=0000:00:01.5  # the expansion bay's PCIe root port
POWER_BUTTON=/dev/input/by-path/platform-PNP0C0C:00-event  # the ACPI power button, which has no by-id link
WAKE_GRAB=1             # seconds to keep swallowing presses after the one that wakes
WAKE_FIFO=/run/light-sleep.wake  # where wait_for_press reads, while a light sleep runs; light-sleep wake writes to it
SYSTEMD_SLEEP=/usr/lib/systemd/systemd-sleep
# What a real suspend runs: systemd-sleep, unless the caller says otherwise (the steamos_vm VM, whose GPU doesn't
# survive one, sets it to true).
SUSPEND="${LIGHT_SLEEP_SUSPEND:-$SYSTEMD_SLEEP}"
DPMS_WAIT=3            # seconds to wait for KWin to turn the displays off
SESSION_USER=deck       # whose KWin (Desktop Mode) session to turn the displays off in
FREEZE_WAIT=5           # seconds to wait for a cgroup to report it is frozen
USER_SLICES="app.slice session.slice background.slice"  # a user manager's slices that hold a graphical session
# The user bus, left running in session.slice: tmux asks the user manager over it for a scope for each server and pane
# it starts, so with it frozen, tmux hangs in SSH and webterm shells.
USER_KEEP="dbus-broker.service dbus.service"

# Log a message to the journal, tagged light-sleep.
# Usage: log <message>...
log() { logger -t light-sleep "$*"; }

# Print the PCI address of each display controller below ROOT_PORT that still answers: once the link is gone its
# config space reads all ones (sysfs's vendor file is cached, so read the config space itself).
# Usage: live_egpus
live_egpus() {
  local dev
  for dev in /sys/bus/pci/devices/*; do
    [[ "$(readlink -f "$dev")" == */$ROOT_PORT/* ]] || continue
    [[ "$(cat "$dev/class")" == 0x03* ]] || continue
    [[ "$(od -An -tx2 -N2 "$dev/config" | tr -d ' ')" != ffff ]] && echo "${dev##*/}"
  done
  return 0
}

# Start an evtest for each keyboard, and the power button, that doesn't have one running. An evtest exits by itself
# when its device goes away, so nothing else needs stopping when devices come and go. Uses wait_for_press's devs and
# pids, and writes to its fd 3.
# Usage: watch_new_devices
watch_new_devices() {
  local dev i running
  shopt -s nullglob
  for dev in /dev/input/by-id/*-event-kbd "$POWER_BUTTON"; do
    running=false
    for i in "${!devs[@]}"; do
      [[ "${devs[$i]}" == "$dev" ]] && kill -0 "${pids[$i]}" 2>/dev/null && running=true
    done
    $running && continue
    stdbuf -oL evtest --grab "$dev" >&3 2>/dev/null &
    devs+=("$dev")
    pids+=($!)
  done
  shopt -u nullglob
}

# Return on the first key or power button press, or a wake line from light-sleep wake, or with status 2 once a power
# supply change (udev's power_supply events: the charger, and the battery's periodic ones) leaves no reason for a light
# sleep, e.g. the charger unplugged with no eGPU attached, so the caller suspends for real. Each evtest grabs its
# device, so the press never reaches the frozen session, whose input queues would otherwise deliver it on thaw (Steam
# would suspend again on the power button). The fifo WAKE_FIFO (root's only) gets evtest's lines, udevadm's and
# light-sleep wake's (light_sleep creates it), and is removed on return; key repeats (value 2) and releases (value 0)
# are ignored, so a key held since before the sleep doesn't wake. The grabs stay for WAKE_GRAB seconds after the press,
# to swallow any presses after it. SIGKILL, not SIGTERM: this script's EXIT trap can make a just-forked job lose a
# SIGTERM before it execs, and an evtest blocked on the full fifo wouldn't act on one.
# Usage: wait_for_press
wait_for_press() {
  local line key monitor status=0 devs=() pids=()
  stdbuf -oL udevadm monitor --udev --subsystem-match=input --subsystem-match=power_supply >&3 2>/dev/null &
  monitor=$!
  watch_new_devices
  while read -r line <&3; do
    case "$line" in
      Event:*'(EV_KEY)'*'value 1')
        key="${line##*\(}"
        log "woken by ${key%%\)*}"
        break
        ;;
      wake)
        log "woken by light-sleep wake"
        break
        ;;
      UDEV*'(power_supply)')
        [[ -z "$(light_sleep_reason)" ]] || continue
        log "no reason for a light sleep any more (${line##*/power_supply/}): suspending"
        status=2
        break
        ;;
      UDEV*' add '*) watch_new_devices ;;
    esac
  done
  rm -f "$WAKE_FIFO"
  sleep "$WAKE_GRAB"
  kill -9 "$monitor" "${pids[@]}" 2>/dev/null
  wait "$monitor" "${pids[@]}" 2>/dev/null
  exec 3>&-
  return "$status"
}

# Turn the displays on or off ($1: on or off) through KWin, if Desktop Mode is running; gamescope does it itself.
# KWin applies a request about a second after kscreen-doctor returns, so off waits until no connector is enabled any
# more (at most DPMS_WAIT seconds) before the freeze stops KWin. On needs KWin thawed, so it comes after the thaw.
# Usage: kwin_dpms on|off
kwin_dpms() {
  local i
  pgrep -x -u "$SESSION_USER" kwin_wayland >/dev/null || return 0
  timeout 10 runuser -u "$SESSION_USER" -- env "XDG_RUNTIME_DIR=/run/user/$(id -u "$SESSION_USER")" \
    WAYLAND_DISPLAY=wayland-0 kscreen-doctor --dpms "$1" >/dev/null 2>&1 || log "kscreen-doctor --dpms $1 failed"
  [[ "$1" == off ]] || return 0
  for ((i = 0; i < DPMS_WAIT * 10; i++)); do
    grep -qx enabled /sys/class/drm/card*-*/enabled 2>/dev/null || return 0
    sleep 0.1
  done
  log "displays still on ${DPMS_WAIT}s after kscreen-doctor --dpms off"
}

# Print whether the laptop is on external power: true or false.
# Usage: on_external_power
on_external_power() {
  local psy
  for psy in /sys/class/power_supply/*; do
    [[ "$(cat "$psy/type" 2>/dev/null)" == Mains && "$(cat "$psy/online" 2>/dev/null)" == 1 ]] && { echo true; return; }
  done
  echo false
}

# Print the cgroup directories that hold the graphical sessions: each wayland or x11 logind session's scope, and each
# unit in its user's USER_SLICES but USER_KEEP. Not the user manager itself (init.scope), webterm.slice or other
# sessions' scopes, such as SSH logins: they keep running, and so do units started during the sleep, such as the
# scopes tmux starts.
# Usage: graphical_cgroups
graphical_cgroups() {
  local id type scope uid cg manager slice unit
  for id in $(loginctl list-sessions --no-legend | awk '{print $1}'); do
    type="$(loginctl show-session "$id" -p Type --value)"
    scope="$(loginctl show-session "$id" -p Scope --value)"
    uid="$(loginctl show-session "$id" -p User --value)"
    [[ "$type" == wayland || "$type" == x11 ]] || continue
    # A unit that is gone (a session closing) has an empty ControlGroup: skip it rather than freeze /sys/fs/cgroup.
    cg="$(systemctl show -p ControlGroup --value "$scope" 2>/dev/null)"
    [[ -z "$scope" || -z "$cg" ]] || echo "/sys/fs/cgroup$cg"
    cg="$(systemctl show -p ControlGroup --value "user@$uid.service" 2>/dev/null)"
    [[ -n "$cg" ]] || continue
    manager="/sys/fs/cgroup$cg"
    for slice in $USER_SLICES; do
      for unit in "$manager/$slice"/*/; do
        unit="${unit%/}"
        [[ -d "$unit" && " $USER_KEEP " != *" ${unit##*/} "* ]] && echo "$unit"
      done
    done
  done | sort -u
}

# Freeze (<state> 1) or thaw (<state> 0) the cgroups <cgroup>... through cgroup.freeze, waiting up to FREEZE_WAIT
# seconds for each to report it. Not through systemctl freeze: a user manager refuses to freeze app.slice (dbus.socket
# in it can't be frozen), and with its dbus-broker frozen in session.slice, its thaw jobs hang.
# Usage: set_frozen <state> <cgroup>...
set_frozen() {
  local want="$1" cg i
  shift
  for cg in "$@"; do
    echo "$want" > "$cg/cgroup.freeze" || { log "failed to set ${cg#/sys/fs/cgroup} frozen=$want"; continue; }
  done
  for cg in "$@"; do
    for ((i = 0; i < FREEZE_WAIT * 10; i++)); do
      grep -qx "frozen $want" "$cg/cgroup.events" 2>/dev/null && break
      sleep 0.1
    done
    grep -qx "frozen $want" "$cg/cgroup.events" 2>/dev/null \
      || log "${cg#/sys/fs/cgroup} not frozen=$want after ${FREEZE_WAIT}s"
  done
}

# Wake NetworkManager, which put itself to sleep (taking every connection down) on logind's PrepareForSleep, as before
# any suspend; a light sleep keeps the machine awake, and SSH and webterm need the network. logind's PrepareForSleep
# after the wake finds it awake, which it ignores.
# Usage: wake_network
wake_network() {
  [[ "$(busctl get-property org.freedesktop.NetworkManager /org/freedesktop/NetworkManager \
    org.freedesktop.NetworkManager State 2>/dev/null)" == "u 10" ]] || return 0  # 10: NM_STATE_ASLEEP
  if busctl call org.freedesktop.NetworkManager /org/freedesktop/NetworkManager org.freedesktop.NetworkManager \
    Sleep b false; then
    log "woke NetworkManager"
  else
    log "failed to wake NetworkManager"
  fi
}

# Put NetworkManager back to sleep before a real suspend, as logind's PrepareForSleep did before wake_network woke it.
# Usage: sleep_network
sleep_network() {
  busctl call org.freedesktop.NetworkManager /org/freedesktop/NetworkManager org.freedesktop.NetworkManager \
    Sleep b true || log "failed to put NetworkManager to sleep"
}

# Print why a suspend should be a light sleep, or nothing when it should really suspend: a live eGPU on the bay would
# lose its link, or the laptop is on external power.
# Usage: light_sleep_reason
light_sleep_reason() {
  local egpus
  egpus="$(live_egpus)"
  if [[ -n "$egpus" ]]; then
    echo "the eGPU at ${egpus//$'\n'/ } would lose its link"
  elif [[ "$(on_external_power)" == true ]]; then
    echo "on external power"
  fi
}

# Freeze the graphical sessions with the displays off until a key or power button press (or light-sleep wake), then
# thaw them and turn the displays back on. If the reason for the light sleep goes away first (the charger unplugged with
# no eGPU attached), suspend for real, still frozen, and thaw on resume.
# Usage: light_sleep
light_sleep() {
  local cgroups=() cg
  # The fifo comes first, so a light-sleep wake sent while the sessions are listed, during the DPMS wait or during the
  # freeze waits in it instead of failing.
  rm -f "$WAKE_FIFO"
  mkfifo -m 600 "$WAKE_FIFO"
  exec 3<>"$WAKE_FIFO"
  trap "rm -f $WAKE_FIFO" EXIT
  while IFS= read -r cg; do
    cgroups+=("$cg")
  done < <(graphical_cgroups)
  if [[ ${#cgroups[@]} -eq 0 ]]; then
    log "no graphical session to freeze"
  else
    log "freezing ${cgroups[*]##*/}"
  fi
  # Expanded and quoted now (unit names hold backslashes): the trap runs after this function returns.
  trap "rm -f $WAKE_FIFO; ${cgroups[0]+set_frozen 0 $(printf '%q ' "${cgroups[@]}");} kwin_dpms on" EXIT
  kwin_dpms off
  [[ ${#cgroups[@]} -eq 0 ]] || set_frozen 1 "${cgroups[@]}"
  wake_network
  wait_for_press && return
  sleep_network
  "$SUSPEND" suspend
  log "resumed from suspend"
  wake_network
}

# End a running light sleep by writing a wake line to WAKE_FIFO. Fails, saying so, when no light sleep is running. The
# write times out, rather than block, if the fifo is left over from a light-sleep that was killed.
# Usage: wake
wake() {
  [[ -p "$WAKE_FIFO" ]] || { echo "light-sleep: no light sleep is running" >&2; return 1; }
  [[ -w "$WAKE_FIFO" ]] || { echo "light-sleep: wake needs root: sudo $0 wake" >&2; return 1; }
  timeout 5 sh -c 'echo wake > "$1"' sh "$WAKE_FIFO" \
    || { echo "light-sleep: $WAKE_FIFO didn't take the wake line; is light-sleep still running?" >&2; return 1; }
  echo "light-sleep: waking"
}

if [[ "$1" == wake ]]; then
  wake
  exit
fi
[[ "$1" == suspend ]] || exec "$SYSTEMD_SLEEP" "$@"
reason="$(light_sleep_reason)"
[[ -n "$reason" ]] || exec "$SUSPEND" "$@"
log "light sleep instead of suspend: $reason"
light_sleep
log "woke from light sleep"
