#!/bin/sh

################################################################################
# Program: vis
# Description: Resumes the vim-obsession session in the current directory, or
#              starts one if none exists. Passes the absolute Session.vim path
#              so tmux-resurrect can restore the session even if nvim changes
#              cwd (see nvim_obsession.sh). Call as "source vis" so the vi
#              alias applies.
# Location: ~/.local/bin/vis
################################################################################

_vis() {
  local session="$PWD/Session.vim"

  if [ -s "$session" ]; then
    vi -S "$session"
  else
    # -S needs an existing file; Obsession then starts tracking it
    : > "$session"
    vi -S "$session" -c Obsession
  fi
}
_vis
unset -f _vis
