#!/bin/bash

################################################################################
# Program: squidpdf
# Description: Takes a pdf file as an argument with (1x) and (5x) A4 pages, and
#              produces an output pdf file with standard A4 pages. Uses mutool
#              to modify pdfs.
# Location: ~/.local/bin/squidpdf
################################################################################

# Print the command line this script takes.
# Usage: usage
usage() { echo "Usage: $0 [-o filename] file.pdf"; }
# Print the message for an input or output file that isn't a .pdf file.
# Usage: badfile
badfile() { echo "Filename invalid or file does not exist. Input and output files must be .pdf files."; }

# Prompts for a positive integer on the terminal and prints it, or 1 if the answer is empty.
# Usage: promptnumber
promptnumber() {
  local reply
  while true; do
    read -r reply < /dev/tty
    [[ -z "$reply" ]] && { echo 1; return; }
    [[ "$reply" =~ ^[1-9][0-9]*$ ]] && { echo "$reply"; return; }
    echo -n "Enter a valid positive integer. (Default 1) " >&2
  done
}

if ! command -v mutool &> /dev/null; then
  echo "'mutool' executable not found. (can be installed as part of the 'mupdf-tools' package in Arch.)"
  exit 1
fi

SHORT=ho:
LONG=help,output:
OPTS=$(getopt --options $SHORT --long $LONG --name "$0" -- "$@") || { usage >&2; exit 2; }

if [[ $# -eq 0 ]]; then
  usage
  exit 0
fi

outfile=
eval set -- "$OPTS"
while true; do
  case "$1" in
    -o | --output ) outfile=$2; shift 2; ;;

    -h | --help )   usage;  exit 0;  ;;
    -- )            shift;  break;   ;;
    * )             usage;  exit 2;  ;;
  esac
done

infile=$1
if [[ ! -f "$infile" ]] || [[ "${infile##*.}" != "pdf" ]]; then
  badfile
  exit 3
fi

[[ -z "$outfile" ]] && outfile=$(basename "$infile" ".pdf")" (A4).pdf"
if [[ -f "$outfile" ]]; then
  echo "File ${outfile} exists. Confirm overwrite."
  rm -vi "$outfile"
  [[ -f "$outfile" ]] && exit 4
  echo
fi


one_length=842
five_length=4210
pages=()
pagenum=1
trap 'rm -f "${pages[@]}"' EXIT

while read -r line; do
  lo=$(sed -E 's/.*b="([0-9.]+)".*/\1/' <<< "$line")
  hi=$(sed -E 's/.*t="([0-9.]+)".*/\1/' <<< "$line")
  length=$(bc <<< "$hi - $lo")

  page=$(mktemp "${TMPDIR:-/tmp}/squidpdf.XXXXXX")
  pages+=( "$page" )
  mutool clean -ggggz "$infile" "$page" $pagenum

  partnum=1
  case $length in
    "$one_length" ) ;;
    "$five_length" ) partnum=5; ;;

    * )
      echo "Page ${pagenum} has length ${length}, which does not match the one-page (${one_length}) or five-page (${five_length}) lengths."
      echo -n "Enter the desired number of partitions. (Default: 1) "

      partnum=$(promptnumber)
      echo
      ;;

  esac

  [[ $partnum -gt 1 ]] && mutool poster -y "$partnum" "$page" "$page"
  pagenum=$((pagenum+1))

done <<< "$(mutool pages "$infile" | grep -E "<MediaBox.*/>")"

if [[ -z $(mutool merge -o "$outfile" "${pages[@]}" 2>&1) ]] ; then 
  echo "Merge successful at $outfile."
else
  echo "Merge failed."
  exit 5
fi
