#!/usr/bin/env bash
# Runs ttyd with the arguments given, adding -I with the page webterm-index built for this exact ttyd binary.
# If there is none (ttyd changed since the last install), ttyd serves its stock page: the terminal works, just without
# the tab shortcuts in fullscreen. exec keeps ttyd as the service's main process.
set -euo pipefail

TTYD="$HOME/.local/bin/ttyd"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/webterm"

index="$STATE_DIR/index-$(sha256sum < "$TTYD" | cut -d' ' -f1).html"
if [ -s "$index" ]; then
  set -- -I "$index" "$@"
else
  echo "warning: no page built for this ttyd, serving the stock page; run ~/dotfiles/install.sh --variant steamos --webterm" >&2
fi
exec "$TTYD" "$@"
