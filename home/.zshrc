#!/bin/zsh
#
# ~/.zshrc
#

source "$HOME/dotfiles/home/.config/sh/env.sh"                       # For shells with no login shell above them

source "$HOME/dotfiles/home/.config/zsh/plugins.zsh"
source "$HOME/dotfiles/home/.config/sh/aliases.sh"
source "$HOME/dotfiles/home/.config/zsh/keybindings.zsh"
source "$HOME/dotfiles/home/.config/zsh/settings.zsh"
source "$HOME/dotfiles/home/.config/zsh/external.zsh"

source "$HOME/dotfiles/home/.config/sh/starship.sh"
