#!/bin/zsh
#
# ~/.zshrc
#

source ~/dotfiles/home/.config/sh/env.sh                             # For shells with no login shell above them

source ~/dotfiles/home/.config/zsh/plugins.zsh
source ~/dotfiles/home/.config/sh/aliases.sh
source ~/dotfiles/home/.config/zsh/keybindings.zsh
source ~/dotfiles/home/.config/zsh/settings.zsh
source ~/dotfiles/home/.config/zsh/external.zsh

source ~/dotfiles/home/.config/sh/starship.sh
