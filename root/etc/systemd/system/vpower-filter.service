# Installed to /etc/systemd/system by the quiet_slow_charger feature of ~/dotfiles/install.sh. Started and stopped with
# vpower.service, whose drop-in vpower-filter.conf pulls it in (so it has no [Install] section).
[Unit]
Description=Copy vpower's state to /run/vpower, with a slow charger shown as connected
BindsTo=vpower.service
After=vpower.service

[Service]
ExecStart=/usr/bin/python3 /etc/dotfiles/bin/vpower-filter
Restart=always
RestartSec=2
