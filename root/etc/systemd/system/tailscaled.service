[Unit]
Description=Tailscale node agent
Documentation=https://tailscale.com/kb/
# Installed to /etc/systemd/system by the tailscale feature of ~/dotfiles/install.sh, from upstream's
# systemd/tailscaled.service with the paths and flags written in rather than read from /etc/default/tailscaled. SteamOS
# keeps services in /etc/systemd/system across updates; the binaries in /etc/dotfiles/bin are on dotfiles' keep list.
Wants=network-pre.target
After=network-pre.target NetworkManager.service systemd-resolved.service

[Service]
ExecStart=/etc/dotfiles/bin/tailscaled --state=/var/lib/tailscale/tailscaled.state --socket=/run/tailscale/tailscaled.sock --port=41641
ExecStopPost=/etc/dotfiles/bin/tailscaled --cleanup
Restart=on-failure
RuntimeDirectory=tailscale
RuntimeDirectoryMode=0755
StateDirectory=tailscale
StateDirectoryMode=0700
CacheDirectory=tailscale
CacheDirectoryMode=0750
Type=notify

[Install]
WantedBy=multi-user.target
