[Unit]
Description=Web terminal (ttyd)
# Stopped together with webterm.service once the proxy exits on idle
StopWhenUnneeded=yes

[Service]
# Its own slice, outside app.slice, so light-sleep (the light_sleep feature) keeps it and the shells and tmux it
# starts running while it freezes the session
Slice=webterm.slice
# Copied into /etc/systemd/user by the webterm feature of ~/dotfiles/install.sh, which also writes token; env
# (shell, font) and the scripts in ~/.local/bin are linked by the link feature. token comes first so env can override it.
EnvironmentFile=%h/.config/webterm/token
EnvironmentFile=%h/.config/webterm/env
WorkingDirectory=%h
ExecStartPre=rm -f %t/webterm.sock
# ttyd can only take its base path (the secret URL token) on the command line, so it shows in /proc/<pid>/cmdline to
# processes of this user (and to other users unless /proc is mounted hidepid=). The unix socket is mode-protected
# and only the proxy reaches it; ttyd has no env or file option for -b, so this is a known limitation.
ExecStart=%h/.local/bin/webterm-ttyd -i %t/webterm.sock -b /${WEBTERM_TOKEN} -W -O -P 10 -t "titleFixed=Web Terminal" -t "fontFamily=${WEBTERM_FONT}" %h/.local/bin/webterm-shell
# Don't let the proxy connect before ttyd is listening
ExecStartPost=sh -c 'for i in $$(seq 50); do [ -S %t/webterm.sock ] && exit 0; sleep 0.1; done; exit 1'
# On stop, signal only ttyd: it hangs up its shells itself. A tmux server started from one of them doesn't live here:
# the tmux function in ~/.config/sh/aliases.sh starts it in a scope of its own in tmux.slice, because tmux 3.7 makes
# every pane PartOf= the server's unit, and stopping this unit on idle would end them all. This only spares a tmux
# that bypassed that function (e.g. /usr/bin/tmux), whose server survives the stop but loses its panes.
KillMode=process
