#!/bin/sh
# Run by home-units.service. Installed to /etc/dotfiles/home-units-start,
# outside the encrypted home. Waits for dirlock to unlock the home directory,
# then starts exactly the units enabled in ~/.config/systemd/user. Nothing else
# is started, so units that already ran and exited are not run again.
#
# It doesn't reload the user manager: the unlock happens at login, and a
# daemon-reload then raced the session's own startup (it hung SteamOS's
# start-gamescope-session, whose session was killed 90s after login). So the
# units' files must be somewhere the manager has seen since boot, like
# /etc/systemd/user, where the webterm feature puts them; only the enable links
# need to be in the home. The manager can't see those links either, so units
# are started only for targets that are already up, and those wanted by a
# target that comes up later aren't started.
set -u

dir="$HOME/.config/systemd/user"

# Encrypted names hide ~/.config until the home directory is unlocked
wait_for_home() {
  until [ -d "$HOME/.config" ]; do sleep 2; done
}

# Succeeds if user target $1 is active or activating, else says why it is skipped
target_is_up() {
  state="$(systemctl --user show -P ActiveState "$1")"
  case "$state" in
    active|activating) ;;
    *) echo "$1 is $state: not starting its units" >&2; return 1 ;;
  esac
}

# Starts the units linked in $1, a <target>.wants or .requires directory, if its
# target is up. Broken links still count: systemd starts units by name
start_target_units() {
  wants="$1"
  target="$(basename "${wants%.*}")"
  target_is_up "$target" || return 0
  set --
  for link in "$wants"/*; do
    [ -e "$link" ] || [ -L "$link" ] || continue
    set -- "$@" "${link##*/}"
  done
  [ $# -gt 0 ] || return 0
  echo "$target: starting $*"
  systemctl --user start --no-block "$@" || echo "warning: could not start some of: $*" >&2
}

main() {
  wait_for_home
  for wants in "$dir"/*.target.wants "$dir"/*.target.requires; do
    [ -d "$wants" ] || continue
    start_target_units "$wants"
  done
}

main
