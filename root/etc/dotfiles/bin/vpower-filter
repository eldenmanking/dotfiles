#!/bin/bash
# Show vpower's state files in /run/vpower for Steam, reporting a slow charger as an ordinary one.
#
# Installed into /etc/dotfiles/bin by the quiet_slow_charger feature of ~/dotfiles/install.sh and run by
# vpower-filter.service. vpower writes /run/vpower/ac_status as "Connected slow" whenever the charger is plugged in but
# the battery drains, and Steam opens its Slow Charger dialog every time that value appears. vpower's drop-in
# (vpower.service.d/vpower-filter.conf) makes it write into /run/vpower-raw instead. This links each of its files there
# into /run/vpower, except ac_status, which it copies whenever the value changes, with "Connected slow" changed to
# "Connected". Battery percentage, low-battery warnings and vpower's shutdown request work as before.
#
# Steam doesn't watch /run/vpower: it reopens each file about once a second, so it follows the links to vpower's
# current files. It runs in a container that sees the host's / at /run/host/root, so the links are relative.
#
# It checks with bash built-ins only, so it starts a process only to make a link (once per file) or when ac_status
# changes.

RAW=/run/vpower-raw
OUT=/run/vpower
FILTERED=ac_status
# The service's own folder (RuntimeDirectory=), on the same filesystem as OUT so files move into OUT by renaming.
STAGE="${RUNTIME_DIRECTORY:-/run/vpower-filter}"
POLL=0.5 # seconds between checks

# Bring /run/vpower up to date with vpower's files: link each one there, and copy ac_status, filtered, when its value
# changed. A file vpower wrote into /run/vpower itself, newer than its counterpart in /run/vpower-raw, is left alone:
# if vpower ever writes there directly again (a SteamOS update changes it, or the drop-in's bind mount no longer
# applies), /run/vpower-raw stops changing, and its old files mustn't replace the new ones. Each file or link is made in
# STAGE and renamed over the old one, so Steam never finds it missing or half-written.
# Usage: update
update() {
  local raw name out text old
  for raw in "$RAW"/*; do
    [[ -f "$raw" ]] || continue
    name="${raw##*/}" out="$OUT/${raw##*/}"
    if [[ "$name" == "$FILTERED" ]]; then
      [[ ! -L "$out" && -e "$out" && ! "$raw" -nt "$out" ]] && continue
      text="" old=""
      # read -d '' reads the whole file (and fails at its end, which is expected).
      IFS= read -r -d '' text < "$raw"
      [[ "$text" == $'Connected slow\n' ]] && text=$'Connected\n'
      [[ -L "$out" || ! -e "$out" ]] || IFS= read -r -d '' old < "$out"
      if [[ -L "$out" || ! -e "$out" || "$old" != "$text" ]]; then
        printf '%s' "$text" > "$STAGE/$name" && mv -fT "$STAGE/$name" "$out"
      fi
    elif [[ ! -L "$out" && (! -e "$out" || "$raw" -nt "$out") ]]; then
      ln -sfT "../${RAW##*/}/$name" "$STAGE/$name" && mv -fT "$STAGE/$name" "$out"
    fi
  done
  # Links to files vpower no longer writes.
  for out in "$OUT"/*; do
    [[ -L "$out" && ! -e "$out" ]] && rm -f "$out"
  done
}

# Update /run/vpower every POLL seconds.
# Usage: main
main() {
  local wait
  mkdir -p "$OUT" "$STAGE" || exit 1
  # A pipe nothing writes to: reading it with a timeout waits like sleep, without starting a process each time.
  exec {wait}<> <(:)
  while true; do
    update
    read -r -t "$POLL" -u "$wait"
  done
}

main "$@"
