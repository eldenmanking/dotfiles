#!/bin/bash
# Mirror vpower's state files into /run/vpower for Steam, reporting a slow charger as an ordinary one.
#
# Installed into /etc/dotfiles/bin by the quiet_slow_charger feature of ~/dotfiles/install.sh and run by
# vpower-filter.service. vpower writes /run/vpower/ac_status as "Connected slow" whenever the charger is plugged in but
# the battery drains, and Steam opens its Slow Charger dialog every time that value appears. vpower's drop-in
# (vpower.service.d/vpower-filter.conf) makes it write into /run/vpower-raw instead; whenever vpower writes there (every
# 2 s), this copies its files to /run/vpower with "Connected slow" changed to "Connected". Every other file and value
# passes through unchanged, so battery percentage, low-battery warnings and vpower's shutdown request work as before.

RAW=/run/vpower-raw
OUT=/run/vpower
# The service's own folder (RuntimeDirectory=), on the same filesystem as OUT so files move into OUT by renaming.
STAGE="${RUNTIME_DIRECTORY:-/run/vpower-filter}"
SEEN="$STAGE/.seen" # emptied before each copy, to tell which of vpower's files are newer than it
POLL=0.5            # seconds between checks

# Succeed if vpower wrote any file since SEEN was last touched.
# Usage: vpower_wrote
vpower_wrote() {
  local raw
  for raw in "$RAW"/*; do
    [[ -f "$raw" && "$raw" -nt "$SEEN" ]] && return 0
  done
  return 1
}

# Copy vpower's files into /run/vpower, with "Connected slow" in ac_status changed to "Connected", and delete copies of
# files vpower no longer writes. The files are copied and edited in STAGE first, then each is renamed over its old copy,
# so Steam never reads a half-written or unfiltered file.
# Usage: copy_files
copy_files() {
  local out
  cp -f "$RAW"/* "$STAGE"/
  [[ ! -e "$STAGE/ac_status" ]] || sed -i 's/^Connected slow$/Connected/' "$STAGE/ac_status"
  mv -f "$STAGE"/* "$OUT"/
  for out in "$OUT"/*; do
    [[ -e "$out" && ! -e "$RAW/${out##*/}" ]] && rm -f "$out"
  done
}

# Copy vpower's files each time it writes them. Only a write triggers a copy, so if vpower ever writes /run/vpower
# directly again (a SteamOS update changes it, or the drop-in's bind mount no longer applies), its files there are left
# alone rather than overwritten from a /run/vpower-raw that stopped changing.
# Usage: main
main() {
  local wait
  mkdir -p "$OUT" "$STAGE" && : > "$SEEN" || exit 1
  # A pipe nothing writes to: reading it with a timeout waits like sleep, without starting a process each time.
  exec {wait}<> <(:)
  while true; do
    if vpower_wrote; then
      # Before copying, so a write during the copy is copied on the next check. Truncating sets its time, like touch.
      : > "$SEEN"
      copy_files
    fi
    read -r -t "$POLL" -u "$wait"
  done
}

main "$@"
