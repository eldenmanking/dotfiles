[Unit]
Description=Web terminal (ttyd)
# Stopped together with webterm.service once the proxy exits on idle
StopWhenUnneeded=yes

[Service]
# token is written by the webterm feature of ~/dotfiles/install.sh, env (shell, font) is linked by the link
# feature. token comes first so env can override it.
EnvironmentFile=%h/.config/webterm/token
EnvironmentFile=%h/.config/webterm/env
WorkingDirectory=%h
ExecStartPre=rm -f %t/webterm.sock
ExecStart=__WEBTERM_DIR__/bin/webterm-ttyd -i %t/webterm.sock -b /${WEBTERM_TOKEN} -W -O -P 10 -t "titleFixed=Web Terminal" -t "fontFamily=${WEBTERM_FONT}" __WEBTERM_DIR__/bin/webterm-shell
# Don't let the proxy connect before ttyd is listening
ExecStartPost=sh -c 'for i in $$(seq 50); do [ -S %t/webterm.sock ] && exit 0; sleep 0.1; done; exit 1'
# On stop, signal only ttyd: it hangs up its shells itself, while a tmux server
# started from one of them keeps running and can be reattached later.
KillMode=process
