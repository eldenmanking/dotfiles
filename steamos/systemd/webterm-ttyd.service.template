[Unit]
Description=Web terminal (ttyd)
# Stopped together with webterm.service once the proxy exits on idle
StopWhenUnneeded=yes

[Service]
# TODO(andywang): update comment
# The browser must have this font installed (see scripts/fetch-font.sh);
# otherwise it falls back to the next family in the list.
Environment="WEBTERM_FONT=JetBrainsMono Nerd Font Mono, JetBrainsMono Nerd Font, monospace"
EnvironmentFile=-%h/.config/webterm/env
WorkingDirectory=%h
ExecStartPre=rm -f %t/webterm.sock
ExecStart=__REPO_DIR__/bin/webterm-ttyd -i %t/webterm.sock -b /${WEBTERM_TOKEN} -W -O -P 10 -t "titleFixed=Web Terminal" -t "fontFamily=${WEBTERM_FONT}" __REPO_DIR__/bin/webterm-shell
# Don't let the proxy connect before ttyd is listening
ExecStartPost=sh -c 'for i in $$(seq 50); do [ -S %t/webterm.sock ] && exit 0; sleep 0.1; done; exit 1'
# On stop, signal only ttyd: it hangs up its shells itself, while a tmux server
# started from one of them keeps running and can be reattached later.
KillMode=process
