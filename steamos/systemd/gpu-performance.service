[Unit]
Description=Force AMD GPUs to manual DPM with the 3D full-screen power profile
# Installed to /etc/systemd/system by the gpu_performance feature of ~/dotfiles/install.sh. SteamOS keeps
# /etc/systemd/system across updates (/usr/lib/rauc/atomic-update-keep.conf), so it needs no keep list.
#
# amdgpu only accepts a pp_power_profile_mode write while the performance level is manual, and profile 1 is
# 3D_FULL_SCREEN (cat pp_power_profile_mode to list them). Cards without these files (non-amdgpu) are skipped.
# It runs again after every resume, in case the driver resets them. Steam's "Manual GPU clock" toggle writes the
# performance level too, so turning it off sets it back to auto until the next boot or resume.
After=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target

[Service]
Type=oneshot
ExecStart=/bin/sh -ec 'for card in /sys/class/drm/card[0-9] /sys/class/drm/card[0-9][0-9]; do \
  dev="$$card/device"; \
  [ -e "$$dev/power_dpm_force_performance_level" ] || continue; \
  echo manual > "$$dev/power_dpm_force_performance_level"; \
  if [ -e "$$dev/pp_power_profile_mode" ]; then echo 1 > "$$dev/pp_power_profile_mode"; fi; \
done'

[Install]
WantedBy=multi-user.target suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
