[Unit]
Description=Set the Framework 16's Radeon 780M to manual clocks so HDMI audio doesn't stutter
# Installed to /etc/systemd/system by the gpu_performance feature of ~/dotfiles/install.sh. SteamOS keeps
# /etc/systemd/system across updates (/usr/lib/rauc/atomic-update-keep.conf), so it needs no keep list.
#
# With the default auto level, HDMI audio from the 780M (0000:c1:00.0) is choppy even though PipeWire reports no
# underruns. The manual level with the graphics clock range committed through pp_od_clk_voltage fixes it. The range
# is the 780M's full one (OD_RANGE), so games still boost to 2700 MHz; high and profile_standard fix it too, but pin
# the clock. Entering manual without the commit leaves the clock pinned at 938 MHz.
# It runs again after every resume, in case the driver resets the level. Steam's "Manual GPU clock" toggle writes
# the level too, so turning it off sets it back to auto until the next boot or resume.
ConditionPathExists=/sys/bus/pci/devices/0000:c1:00.0/power_dpm_force_performance_level
After=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target

[Service]
Type=oneshot
ExecStart=/bin/sh -ec 'dev=/sys/bus/pci/devices/0000:c1:00.0; \
  echo manual > "$$dev/power_dpm_force_performance_level"; \
  echo "s 0 800" > "$$dev/pp_od_clk_voltage"; \
  echo "s 1 2700" > "$$dev/pp_od_clk_voltage"; \
  echo c > "$$dev/pp_od_clk_voltage"'

[Install]
WantedBy=multi-user.target suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
