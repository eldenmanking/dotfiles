#!/bin/sh
# Run by home-units.service. Installed to /etc/dotfiles/home-units-start,
# outside the encrypted home. Waits for dirlock to unlock the home directory
# and for the session to start, reloads the user manager so it sees
# ~/.config/systemd/user, then starts
# exactly the units enabled there. Nothing else is started, so units that
# already ran and exited are not run again.
#
# Units are started only for targets that are already up. A target that comes
# up later (e.g. graphical-session.target when you switch to Desktop Mode)
# starts its own units then, since the reload made them visible.
set -u

dir="$HOME/.config/systemd/user"

# Encrypted names hide ~/.config until the home directory is unlocked
wait_for_home() {
  until [ -d "$HOME/.config" ]; do sleep 2; done
}

# Logging in unlocks the home, so the session's own startup runs at the same time. A daemon-reload in the middle of
# SteamOS's start-gamescope-session hung its systemctl calls for 30s, and the session was killed 90s after login
# (taking Steam and every app with it). Wait for the session (Game Mode and Desktop Mode both reach
# graphical-session.target) to finish starting, or up to 60s if it never does, e.g. for an ssh login.
wait_for_session() {
  i=0
  while [ "$i" -lt 60 ]; do
    [ "$(systemctl --user show -P ActiveState graphical-session.target)" = active ] && return
    sleep 1
    i=$((i + 1))
  done
  echo "graphical-session.target did not start within 60s; reloading anyway"
}

# TODO(andywang): add comment
target_is_up() {
  state="$(systemctl --user show -P ActiveState "$1")"
  case "$state" in
    active|activating) ;;
    *) echo "$1 is $state: leaving its units for when it starts"; return 1 ;;
  esac
}

# TODO(andywang): add comment
start_target_units() {
  wants="$1"
  target="$(basename "${wants%.*}")"
  target_is_up "$target" || return 0
  set --
  for link in "$wants"/*; do
    [ -e "$link" ] || [ -L "$link" ] || continue
    set -- "$@" "${link##*/}"
  done
  [ $# -gt 0 ] || return 0
  echo "$target: starting $*"
  systemctl --user start --no-block "$@" || echo "warning: could not start some of: $*" >&2
}

main() {
  wait_for_home
  wait_for_session
  systemctl --user daemon-reload || exit 1
  for wants in "$dir"/*.target.wants "$dir"/*.target.requires; do
    [ -d "$wants" ] || continue
    start_target_units "$wants"
  done
}

main
