#!/usr/bin/env bash
# TODO(andywang): update comment
# Builds the page that bin/webterm-ttyd passes to ttyd with -I: ttyd's stock page with web/tab-keys.html appended.
# The stock page bundles ttyd's browser client, so it is fetched from a throwaway ttyd on a temporary UNIX socket and
# saved under the hash of bin/ttyd. Runs from install-systemd.sh, so it is redone whenever ttyd is (re)installed.
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TTYD="$REPO_DIR/bin/ttyd"
SNIPPET="$REPO_DIR/web/tab-keys.html"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/webterm"

[ -x "$TTYD" ] || { echo "error: $TTYD not found" >&2; exit 1; }
index="$STATE_DIR/index-$(sha256sum < "$TTYD" | cut -d' ' -f1).html"

[ -s "$SNIPPET" ] || { echo "error: $SNIPPET not found" >&2; exit 1; }

tmp=""
pid=""
finish() {
  if [ -n "$pid" ]; then kill "$pid" 2>/dev/null || true; wait "$pid" 2>/dev/null || true; fi
  if [ -n "$tmp" ]; then rm -rf "$tmp"; fi
}
trap finish EXIT

tmp="$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/webterm-index.XXXXXX")"
"$TTYD" -i "$tmp/ttyd.sock" true > "$tmp/ttyd.log" 2>&1 &
pid=$!

for _ in $(seq 50); do
  if curl -fsS --noproxy '*' --max-time 2 --unix-socket "$tmp/ttyd.sock" -o "$tmp/index.html" http://localhost/ 2>/dev/null; then
    break
  fi
  kill -0 "$pid" 2>/dev/null || { cat "$tmp/ttyd.log" >&2; echo "error: ttyd exited early" >&2; exit 1; }
  sleep 0.1
done
grep -qi '<html' "$tmp/index.html" 2>/dev/null || { echo "error: could not fetch the stock page from ttyd" >&2; exit 1; }

mkdir -p "$STATE_DIR"
new="$(mktemp "$STATE_DIR/.index.XXXXXX")"
cat "$tmp/index.html" "$SNIPPET" > "$new" || { rm -f "$new"; exit 1; }
chmod 644 "$new"
mv -f "$new" "$index"
find "$STATE_DIR" -maxdepth 1 -name 'index-*.html' ! -path "$index" -delete
echo "Wrote $index"
